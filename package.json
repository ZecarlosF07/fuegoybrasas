{
  "name": "polleria-parcona",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "node scripts/run-remote-next.mjs dev",
    "build": "node scripts/run-remote-next.mjs build",
    "start": "node scripts/run-remote-next.mjs start",
    "dev:local": "next dev",
    "build:local": "next build",
    "start:local": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "yarn build:local && node scripts/build-ui-fixture.mjs && playwright test",
    "test:manual:h6": "playwright test --config playwright.manual.config.ts",
    "test:db": "node scripts/supabase.mjs test db",
    "test:boundary": "node scripts/test-server-boundary.mjs",
    "test:release": "node --test scripts/lib/deployment.test.mjs",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check:repository-secrets": "node scripts/check-repository-secrets.mjs",
    "release:check": "node scripts/check-deployment.mjs",
    "staff:bootstrap:official": "node scripts/bootstrap-official-admin.mjs",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset --local",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:types:local": "node scripts/generate-db-types.mjs --local",
    "env:local": "node scripts/setup-local-env.mjs",
    "env:remote": "node scripts/setup-remote-env.mjs",
    "env:h2": "node scripts/prepare-h2-env.mjs",
    "dev:remote": "node scripts/run-remote-next.mjs dev",
    "build:remote": "node scripts/run-remote-next.mjs build",
    "start:remote": "node scripts/run-remote-next.mjs start",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "staff:bootstrap:local": "node scripts/bootstrap-staff.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "26.1.0",
    "pg": "8.23.1",
    "playwright-core": "1.63.0",
    "supabase": "2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
