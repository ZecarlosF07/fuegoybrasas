# Desarrollo habitual: .env.remote.local, generado con yarn env:remote.
# .env.local se reserva para las pruebas aisladas; no es requisito para yarn dev.
NEXT_PUBLIC_SUPABASE_URL=https://geazxsvjkqpzbghlywbw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
APP_SITE_URL=http://localhost:3000
# Servidor exclusivamente: administración/Auth y acceso privado de tarjetas.
SUPABASE_SECRET_KEY=
# Secreto independiente de 32 bytes o más, generado con yarn env:h2.
STAFF_AUTH_FLOW_SECRET=
# Solo pruebas y bootstrap LOCAL; nunca NEXT_PUBLIC ni despliegue web.
SUPABASE_LOCAL_DB_URL=
# Aprobación de textos versionada: src/features/loyalty/config/documents-approval.json.
# El administrador pausa o reanuda fidelización desde la configuración de negocio.
# H8: diagnóstico de códigos/latencia con allowlist; nunca cuerpos o datos privados.
APP_TELEMETRY_ENABLED=false
# SHA del código desplegado; no introducir etiquetas libres ni secretos.
APP_RELEASE_ID=
# Desarrollo habitual conserva el proyecto remoto; despliegues usan su perfil explícito.
APP_DEPLOYMENT_TARGET=development
# Habilitar solo en producción aceptada; preview y desarrollo siguen excluidos.
APP_INDEXING_ENABLED=false
